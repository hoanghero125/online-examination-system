<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.group2.oes.ui.controller.RulesController" styleClass="centered-page">
    <VBox fx:id="form" styleClass="card" maxWidth="620" maxHeight="-Infinity" spacing="14">
        <Label text="Xác nhận quy chế thi" styleClass="caption"/>
        <Label fx:id="titleLabel" styleClass="title" wrapText="true"/>
        <GridPane hgap="16" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="150"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Môn" styleClass="field-label" GridPane.rowIndex="0"/>
            <Label fx:id="subjectLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Đề thi" styleClass="field-label" GridPane.rowIndex="1"/>
            <Label fx:id="questionsLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Giờ đóng ca" styleClass="field-label" GridPane.rowIndex="2"/>
            <Label fx:id="closeLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Thời gian còn lại" styleClass="field-label" GridPane.rowIndex="3"/>
            <Label fx:id="remainingLabel" text="…" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>
        <VBox styleClass="rules-box" spacing="6">
            <Label text="Quy chế" styleClass="field-label"/>
            <Label text="Bài làm hiển thị ở chế độ toàn màn hình, không thoát ra được cho tới khi nộp bài." wrapText="true"/>
            <Label fx:id="rulesLabel" wrapText="true"/>
        </VBox>
        <Label fx:id="resumeLabel" styleClass="resume-note" wrapText="true"/>
        <CheckBox fx:id="agreeBox" text="Tôi đã đọc và đồng ý với quy chế thi"/>
        <HBox styleClass="button-row">
            <Button text="Quay lại" onAction="#onBack"/>
            <Button fx:id="startButton" text="Bắt đầu làm bài" defaultButton="true" onAction="#onStart" styleClass="primary"/>
        </HBox>
    </VBox>
</StackPane>
