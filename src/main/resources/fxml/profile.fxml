<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="form"
      fx:controller="com.group2.oes.ui.controller.ProfileController" spacing="14" maxWidth="560">
    <Label text="Hồ sơ" styleClass="title"/>
    <GridPane hgap="14" vgap="12" styleClass="card">
        <columnConstraints>
            <ColumnConstraints minWidth="130"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Tên đăng nhập" styleClass="field-label" GridPane.rowIndex="0"/>
        <Label fx:id="usernameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Vai trò" styleClass="field-label" GridPane.rowIndex="1"/>
        <Label fx:id="roleLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Họ tên" styleClass="field-label" GridPane.rowIndex="2"/>
        <TextField fx:id="fullNameField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Email" styleClass="field-label" GridPane.rowIndex="3"/>
        <TextField fx:id="emailField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox styleClass="button-row">
        <Button text="Đổi mật khẩu…" onAction="#onChangePassword"/>
        <Button text="Lưu" onAction="#onSave" styleClass="primary"/>
    </HBox>
</VBox>
