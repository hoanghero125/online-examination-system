<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="page"
      fx:controller="com.group2.oes.ui.controller.UsersController" spacing="12">
    <Label text="Người dùng" styleClass="title"/>
    <HBox spacing="10" styleClass="toolbar">
        <TextField fx:id="keywordField" promptText="Tìm theo tên đăng nhập, họ tên, mã sinh viên" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="roleBox" prefWidth="160"/>
        <Button text="Tìm" onAction="#onSearch"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <HBox spacing="10" styleClass="toolbar">
        <Button text="Thêm" onAction="#onAdd" styleClass="primary"/>
        <Button text="Sửa" onAction="#onEdit"/>
        <Button text="Khóa / Mở khóa" onAction="#onToggleActive"/>
        <Button text="Đặt lại mật khẩu" onAction="#onResetPassword"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nhập thí sinh từ CSV…" onAction="#onImport"/>
        <Button text="?" onAction="#onImportHelp"/>
    </HBox>
</VBox>
