<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.group2.oes.ui.controller.ChangePasswordController" styleClass="centered-page">
    <VBox fx:id="form" styleClass="card" maxWidth="440" maxHeight="-Infinity" spacing="10">
        <Label fx:id="headerLabel" text="Đổi mật khẩu" styleClass="title"/>
        <Label fx:id="noteLabel" text="Mật khẩu mới phải có ít nhất 6 ký tự." wrapText="true" styleClass="muted"/>
        <Label text="Mật khẩu hiện tại" styleClass="field-label"/>
        <PasswordField fx:id="oldField"/>
        <Label text="Mật khẩu mới" styleClass="field-label"/>
        <PasswordField fx:id="newField"/>
        <Label text="Nhập lại mật khẩu mới" styleClass="field-label"/>
        <PasswordField fx:id="confirmField" onAction="#onSave"/>
        <HBox spacing="10" styleClass="button-row">
            <Button fx:id="cancelButton" text="Hủy" onAction="#onCancel"/>
            <Button text="Lưu mật khẩu" defaultButton="true" onAction="#onSave" styleClass="primary"/>
        </HBox>
    </VBox>
</StackPane>
