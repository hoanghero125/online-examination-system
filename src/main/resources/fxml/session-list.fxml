<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group2.oes.ui.controller.SessionListController">
    <top>
        <HBox styleClass="top-bar" spacing="12">
            <Label text="Hệ thống thi trực tuyến" styleClass="brand"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" styleClass="top-user"/>
            <Button text="Đổi mật khẩu" onAction="#onChangePassword" styleClass="flat-light"/>
            <Button text="Đăng xuất" onAction="#onLogout" styleClass="flat-light"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="page-scroll">
            <VBox fx:id="page" styleClass="content" spacing="12">
                <HBox spacing="12" styleClass="section-head">
                    <Label text="Ca thi của bạn" styleClass="title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Làm mới" onAction="#onRefresh"/>
                </HBox>
                <Label text="Đang mở" styleClass="subtitle"/>
                <VBox fx:id="openBox" spacing="8"/>
                <Label text="Sắp diễn ra" styleClass="subtitle"/>
                <VBox fx:id="upcomingBox" spacing="8"/>
                <Label text="Đã kết thúc" styleClass="subtitle"/>
                <VBox fx:id="closedBox" spacing="8"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
