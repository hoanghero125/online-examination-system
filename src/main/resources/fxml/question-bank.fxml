<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="page"
      fx:controller="com.group2.oes.ui.controller.QuestionBankController" spacing="12">
    <HBox spacing="12" styleClass="section-head">
        <Label text="Ngân hàng câu hỏi" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Môn"/>
        <ComboBox fx:id="subjectBox" prefWidth="280"/>
    </HBox>
    <HBox spacing="10" styleClass="toolbar">
        <ComboBox fx:id="chapterBox" prefWidth="130"/>
        <ComboBox fx:id="difficultyBox" prefWidth="130"/>
        <ComboBox fx:id="typeBox" prefWidth="140"/>
        <TextField fx:id="keywordField" promptText="Tìm trong nội dung" HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="muted"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <HBox spacing="10" styleClass="toolbar">
        <Button text="Thêm câu hỏi" onAction="#onAdd" styleClass="primary"/>
        <Button text="Sửa" onAction="#onEdit"/>
        <Button text="Xóa" onAction="#onDelete"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nhập từ tệp…" onAction="#onImport"/>
        <Button text="?" onAction="#onImportHelp"/>
    </HBox>
</VBox>
