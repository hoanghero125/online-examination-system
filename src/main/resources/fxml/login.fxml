<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.group2.oes.ui.controller.LoginController" styleClass="centered-page">
    <VBox fx:id="form" styleClass="card" maxWidth="420" maxHeight="-Infinity" spacing="10">
        <Label text="Hệ thống thi trực tuyến" styleClass="caption"/>
        <Label fx:id="appTitleLabel" styleClass="title"/>
        <Label text="Tên đăng nhập" styleClass="field-label"/>
        <TextField fx:id="usernameField" promptText="ví dụ: b24dcce098"/>
        <Label text="Mật khẩu" styleClass="field-label"/>
        <PasswordField fx:id="passwordField" onAction="#onLogin"/>
        <Button text="Đăng nhập" defaultButton="true" onAction="#onLogin" styleClass="primary" maxWidth="Infinity"/>
        <Hyperlink text="Đổi máy chủ CSDL" onAction="#onChangeServer"/>
    </VBox>
</StackPane>
