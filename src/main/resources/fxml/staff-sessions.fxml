<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="page"
      fx:controller="com.group2.oes.ui.controller.StaffSessionsController" spacing="12">
    <HBox spacing="12" styleClass="section-head">
        <Label text="Ca thi" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Môn"/>
        <ComboBox fx:id="subjectBox" prefWidth="280"/>
        <Button text="Làm mới" onAction="#onRefresh"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <HBox styleClass="button-row">
        <Button text="Xem kết quả" onAction="#onResults" styleClass="primary"/>
    </HBox>
</VBox>
