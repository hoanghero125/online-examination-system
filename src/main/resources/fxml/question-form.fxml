<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="form"
      fx:controller="com.group2.oes.ui.controller.QuestionFormController" spacing="8" styleClass="dialog-form" prefWidth="640">
    <fx:define>
        <ToggleGroup fx:id="tfGroup"/>
    </fx:define>
    <HBox spacing="12">
        <VBox spacing="4">
            <Label text="Loại câu hỏi" styleClass="field-label"/>
            <ComboBox fx:id="typeBox" prefWidth="170"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Chương" styleClass="field-label"/>
            <Spinner fx:id="chapterSpinner" prefWidth="90" editable="true" min="1" max="50" initialValue="1"/>
            <Label fx:id="chapterError" styleClass="field-error"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Mức độ" styleClass="field-label"/>
            <ComboBox fx:id="difficultyBox" prefWidth="130"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Điểm mặc định" styleClass="field-label"/>
            <TextField fx:id="pointField" prefWidth="90"/>
            <Label fx:id="pointError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>
    <Label text="Nội dung câu hỏi" styleClass="field-label"/>
    <TextArea fx:id="contentArea" prefRowCount="3" wrapText="true"/>
    <Label fx:id="contentError" styleClass="field-error"/>

    <VBox fx:id="optionsPane" spacing="6">
        <Label text="Phương án (đánh dấu ô Đúng cho phương án đúng)" styleClass="field-label"/>
        <VBox fx:id="optionRows" spacing="6"/>
        <Button text="+ Thêm phương án" onAction="#onAddOption"/>
        <Label fx:id="optionsError" styleClass="field-error" wrapText="true"/>
    </VBox>

    <VBox fx:id="trueFalsePane" spacing="6">
        <Label text="Đáp án đúng" styleClass="field-label"/>
        <HBox spacing="20">
            <RadioButton fx:id="trueRadio" text="Đúng" toggleGroup="$tfGroup"/>
            <RadioButton fx:id="falseRadio" text="Sai" toggleGroup="$tfGroup"/>
        </HBox>
        <Label fx:id="trueFalseError" styleClass="field-error"/>
    </VBox>

    <VBox fx:id="fillPane" spacing="6">
        <Label text="Các đáp án được chấp nhận (mỗi dòng một đáp án)" styleClass="field-label"/>
        <TextArea fx:id="acceptedArea" prefRowCount="3"/>
        <CheckBox fx:id="caseBox" text="Phân biệt chữ hoa, chữ thường"/>
        <Label text="Khoảng trắng thừa luôn được bỏ qua. Nếu không phân biệt hoa thường, đáp án được lưu ở dạng chữ thường."
               styleClass="muted" wrapText="true"/>
        <Label fx:id="acceptedError" styleClass="field-error"/>
    </VBox>

    <HBox styleClass="button-row">
        <Button text="Hủy" onAction="#onCancel"/>
        <Button text="Lưu câu hỏi" defaultButton="true" onAction="#onSave" styleClass="primary"/>
    </HBox>
</VBox>
