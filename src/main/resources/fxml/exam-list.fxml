<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="page"
      fx:controller="com.group2.oes.ui.controller.ExamListController" spacing="12">
    <HBox spacing="12" styleClass="section-head">
        <Label text="Đề thi" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Môn"/>
        <ComboBox fx:id="subjectBox" prefWidth="280"/>
    </HBox>
    <Label text="Đề đã dùng cho ca thi bị khóa, không sửa được; muốn đổi thì tạo phiên bản mới." styleClass="muted"/>
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <HBox spacing="10" styleClass="toolbar">
        <Button text="Tạo đề mới" onAction="#onCreate" styleClass="primary"/>
        <Button text="Tạo phiên bản mới" onAction="#onNewVersion"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Mở ca thi với đề này…" onAction="#onOpenSession" styleClass="primary"/>
    </HBox>
</VBox>
