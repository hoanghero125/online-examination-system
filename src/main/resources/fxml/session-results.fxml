<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="page"
      fx:controller="com.group2.oes.ui.controller.SessionResultsController" spacing="10">
    <HBox spacing="12" styleClass="section-head">
        <Label text="Kết quả ca thi" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Làm mới" onAction="#onRefresh"/>
        <Button text="Xuất CSV…" onAction="#onExport" styleClass="primary"/>
        <Button text="Quay lại" onAction="#onBack"/>
    </HBox>
    <Label fx:id="titleLabel" styleClass="field-label" wrapText="true"/>
    <Label fx:id="summaryLabel" styleClass="summary"/>
    <TableView fx:id="resultTable" VBox.vgrow="ALWAYS" minHeight="180"/>
    <HBox spacing="12" prefHeight="260">
        <BarChart fx:id="histogram" title="Phổ điểm (hệ 10)" legendVisible="false" animated="false" prefWidth="420">
            <xAxis>
                <CategoryAxis label="Điểm (làm tròn xuống)"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="Số bài" tickUnit="1" minorTickVisible="false"/>
            </yAxis>
        </BarChart>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Tỷ lệ trọn điểm từng câu (câu khó nhất ở trên)" styleClass="field-label"/>
            <TableView fx:id="itemTable" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>
</VBox>
