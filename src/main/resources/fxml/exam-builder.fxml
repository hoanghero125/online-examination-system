<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="page"
      fx:controller="com.group2.oes.ui.controller.ExamBuilderController" spacing="12">
    <HBox spacing="12" styleClass="section-head">
        <Label text="Tạo đề thi" styleClass="title"/>
        <Label fx:id="subjectLabel" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Quay lại" onAction="#onBack"/>
    </HBox>
    <HBox spacing="12" styleClass="toolbar">
        <Label text="Tên đề"/>
        <TextField fx:id="titleField" promptText="ví dụ: Kiểm tra giữa kỳ" HBox.hgrow="ALWAYS"/>
        <Label text="Câu nhiều đáp án"/>
        <ComboBox fx:id="policyBox" prefWidth="300"/>
    </HBox>
    <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab fx:id="manualTab" text="Chọn tay">
            <HBox spacing="12" styleClass="tab-body">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Ngân hàng câu hỏi" styleClass="field-label"/>
                    <TextField fx:id="keywordField" promptText="Tìm trong nội dung"/>
                    <TableView fx:id="bankTable" VBox.vgrow="ALWAYS"/>
                </VBox>
                <VBox spacing="8" alignment="CENTER">
                    <Label text="Điểm khi thêm"/>
                    <TextField fx:id="defaultPointField" promptText="mặc định" prefWidth="80"/>
                    <Button text="Thêm ▶" onAction="#onAddPick" styleClass="primary"/>
                    <Button text="◀ Bỏ" onAction="#onRemovePick"/>
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Câu trong đề (bấm đúp ô điểm để sửa)" styleClass="field-label"/>
                    <TableView fx:id="pickedTable" VBox.vgrow="ALWAYS"/>
                    <Label fx:id="totalLabel" styleClass="field-label"/>
                </VBox>
            </HBox>
        </Tab>
        <Tab text="Theo ma trận">
            <VBox spacing="12" styleClass="tab-body">
                <Label text="Nhập số câu cần lấy cho từng chương và mức độ. Câu được chọn ngẫu nhiên trong ngân hàng."
                       styleClass="muted" wrapText="true"/>
                <GridPane fx:id="matrixGrid" hgap="18" vgap="10"/>
                <HBox spacing="10" styleClass="toolbar">
                    <Label text="Điểm mỗi câu"/>
                    <TextField fx:id="pointEachField" text="1" prefWidth="80"/>
                    <Button text="Kiểm tra ma trận" onAction="#onCheckMatrix"/>
                </HBox>
                <Label fx:id="matrixResult" wrapText="true" styleClass="field-label"/>
            </VBox>
        </Tab>
    </TabPane>
    <HBox styleClass="button-row">
        <Button text="Tạo đề" onAction="#onCreate" styleClass="primary"/>
    </HBox>
</VBox>
