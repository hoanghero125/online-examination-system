<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.group2</groupId>
    <artifactId>online-examination-system</artifactId>
    <version>0.6.0</version>
    <name>Online Examination System - Nhom 2</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <javafx.version>21.0.5</javafx.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- Giao diện: chỉ dùng controls và fxml, không cần web/media -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Driver JDBC cho MySQL. Chỉ cần lúc chạy, mã nguồn chỉ dùng java.sql -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                    <showWarnings>true</showWarnings>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!--
              mvn compile exec:java          : kịch bản ConsoleDemo, không cần giao diện
              mvn compile exec:java@setup    : dựng CSDL + cấu hình + dữ liệu mẫu (scripts/setup gọi lệnh này)
              mvn compile exec:java@seed     : chỉ tạo dữ liệu mẫu trên CSDL đã có
              mvn compile exec:java@grading  : máy chấm không giao diện
              Tham số thêm truyền qua -Dexec.args="..."
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>com.group2.oes.app.ConsoleDemo</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>setup</id>
                        <configuration>
                            <mainClass>com.group2.oes.tools.DatabaseSetup</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>seed</id>
                        <configuration>
                            <mainClass>com.group2.oes.tools.SeedTool</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>grading</id>
                        <configuration>
                            <mainClass>com.group2.oes.app.GradingDaemon</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              mvn package : tạo hai tệp jar chạy độc lập trong thư mục dist/
                dist/oes-staff.jar  (ứng dụng quản lý; chứa cả GradingDaemon và SeedTool)
                dist/oes-client.jar (ứng dụng thi)
              Jar gồm cả JavaFX, mà JavaFX có phần native theo hệ điều hành: build trên hệ điều hành nào
              thì chạy trên hệ điều hành đó.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>module-info.class</exclude>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                                <exclude>META-INF/MANIFEST.MF</exclude>
                            </excludes>
                        </filter>
                    </filters>
                </configuration>
                <executions>
                    <execution>
                        <id>staff</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.basedir}/dist/oes-staff.jar</outputFile>
                            <transformers>
                                <!-- driver MySQL tự đăng ký qua META-INF/services: phải gộp chứ không ghi đè -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.group2.oes.ui.StaffLauncher</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                    <execution>
                        <id>client</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.basedir}/dist/oes-client.jar</outputFile>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.group2.oes.ui.ClientLauncher</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              mvn javafx:run@staff  : ứng dụng quản lý (quản trị viên, giảng viên)
              mvn javafx:run@client : ứng dụng thi (thí sinh)
            -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <executions>
                    <execution>
                        <id>staff</id>
                        <configuration>
                            <mainClass>com.group2.oes.ui.StaffApp</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>client</id>
                        <configuration>
                            <mainClass>com.group2.oes.ui.ExamClientApp</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
